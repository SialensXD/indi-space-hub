# Telegram BotFather token. Rotate the token that was previously committed.
BOT_TOKEN=replace-me

# Supabase PostgreSQL connection string.
# For Supabase transaction pooler, keep statement caching disabled in the app.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Render provides this automatically for a web service when configured.
RENDER_EXTERNAL_URL=https://your-service.onrender.com
PORT=10000
WEBHOOK_SECRET=generate-a-random-secret

